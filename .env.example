# Copy this file to .env and adjust. Every value is optional; the defaults are shown.

# Where extraction results are stored. Any SQLAlchemy async URL works.
DATABASE_URL=sqlite+aiosqlite:///./extractions.db

# Largest file accepted by the upload endpoint, in bytes. 20971520 is 20 MB.
MAX_UPLOAD_BYTES=20971520

# Longest document accepted, in pages.
MAX_PAGES=300
