# Copy this file to .env and adjust. Every value is optional; the defaults are shown.

# Where extraction results are stored. Any SQLAlchemy async URL works.
DATABASE_URL=sqlite+aiosqlite:///./extractions.db

# Largest file accepted by the upload endpoint, in bytes. 20971520 is 20 MB.
MAX_UPLOAD_BYTES=20971520

# Longest document accepted, in pages.
MAX_PAGES=300

# --- LLM ---

# Which provider to use:
#   deepseek            DeepSeek's own API.
#   openai_compatible   Any other API with the OpenAI wire format. Needs LLM_BASE_URL.
LLM_PROVIDER=deepseek

# Required: the server does not start without it.
# the real .env file is ignored by git.
LLM_API_KEY=

LLM_MODEL=deepseek-flash

# Replaces the provider's own address. Required for openai_compatible.
# LLM_BASE_URL=https://llm.example/v1

# Passed to the provider as it is. DeepSeek accepts none, low, high and max.
LLM_REASONING_EFFORT=high

# Upper limit for one answer, in tokens. The model's reasoning counts towards it.
LLM_MAX_OUTPUT_TOKENS=128000

# For one attempt, in seconds. Failed attempts are retried with backoff.
LLM_TIMEOUT_SECONDS=300
LLM_MAX_RETRIES=2
